<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main_layout"
    android:padding="14dp"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ScrollView diubah height-nya jadi 0dp (Match Constraint) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/text_input_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_blue"
                android:textStyle="bold|italic"
                android:text="@string/paragraf"/>

        </LinearLayout>
    </ScrollView>

    <!-- Tambahkan ID di sini agar bisa dijadikan patokan constraint -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btn_click"
        app:counterEnabled="true"
        app:counterMaxLength="50">

        <EditText
            android:id="@+id/edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="Masukkan teks di sini"/>

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btn_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:backgroundTint="@color/dark_blue"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:text="Klik Disini" />

</androidx.constraintlayout.widget.ConstraintLayout>